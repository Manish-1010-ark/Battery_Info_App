<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#1A1A24"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Battery Percentage -->
    <TextView
        android:id="@+id/notification_battery_percentage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔋 --%"
        android:textColor="#E0E0E0"
        android:textSize="16sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:layout_marginBottom="4dp" />

    <!-- Charging Power / Discharging -->
    <TextView
        android:id="@+id/notification_charging_power"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚡ -- W"
        android:textColor="#00E5FF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:layout_marginBottom="4dp"
        android:maxLines="1"
        android:ellipsize="none" />

    <!-- Temperature -->
    <TextView
        android:id="@+id/notification_temperature"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🌡️ --°C"
        android:textColor="#FF8800"
        android:textSize="14sp"
        android:fontFamily="monospace"
        android:layout_marginBottom="4dp" />

    <!-- Time Remaining -->
    <TextView
        android:id="@+id/notification_time_remaining"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⌛ Calculating..."
        android:textColor="#A0A0A0"
        android:textSize="13sp"
        android:maxLines="2"
        android:ellipsize="end" />

</LinearLayout>